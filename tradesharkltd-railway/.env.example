# ============================================================
# TradeShark Ltd – Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── App & Server ────────────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com
APP_NAME=TradeShark

# ── Company / Brand ─────────────────────────────────────────
COMPANY_LEGAL_NAME=TradeShark Ltd
COMPANY_ADDRESS=123 Finance Street, London, EC2V 8RT, United Kingdom
COMPANY_NUMBER=14567890
SUPPORT_EMAIL=support@tradeshark.com
SUPPORT_PHONE=+44 20 1234 5678
SUPPORT_WHATSAPP=+447911123456
REGULATORY_TEXT=TradeShark Ltd is authorised and regulated by the FCA (Firm Reference 987654).
APP_TAGLINE=Trade stocks, crypto, ETFs and more with zero commission

# ── Email (REQUIRED for OTP / Registration emails) ─────────
# Option 1: Use Resend (recommended – free tier: 100 emails/day)
#   Sign up at https://resend.com → get your API key
RESEND_API_KEY=re_your_resend_api_key_here

# Option 2: Use any SMTP provider (Gmail, SendGrid, Mailgun, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password

# Email sender details
MAIL_FROM_NAME=TradeShark Security
MAIL_FROM_ADDRESS=noreply@tradeshark.com
MAIL_REPLY_TO=support@tradeshark.com

# Set to true to send login alert emails
EMAIL_LOGIN_ALERTS=false
# Set to true to block unverified users from logging in
REQUIRE_EMAIL_VERIFICATION=false

# ── Admin Credentials ────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password-here
ADMIN_EMAIL=admin@tradeshark.com
ADMIN_NAME=Administrator

# Optional: extra admin roles
# COMPLIANCE_PASSWORD=compliance-password
# TREASURY_PASSWORD=treasury-password

# ── AI Assistant (Shark AI) ──────────────────────────────────
# Get your free Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── Trading & Account Settings ───────────────────────────────
MIN_DEPOSIT=100
MIN_WITHDRAWAL=50
PRACTICE_BALANCE=100000
SIGNUP_BONUS=0

# ── Demo / Seed Data ─────────────────────────────────────────
SEED_DEMO_DATA=false
ENABLE_DEMO_LOGINS=false

# ── Social Links ─────────────────────────────────────────────
SOCIAL_FACEBOOK=https://facebook.com/tradesharkltd
SOCIAL_INSTAGRAM=https://instagram.com/tradesharkltd
SOCIAL_X=https://x.com/tradesharkltd
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=
SOCIAL_TELEGRAM=

# ── Deposit Payment Details ──────────────────────────────────
DEPOSIT_BANK_NAME=Barclays Bank PLC
DEPOSIT_BANK_ACCOUNT_NAME=TradeShark Ltd Client Account
DEPOSIT_BANK_ACCOUNT_NUMBER=12345678
DEPOSIT_BANK_SORT_CODE=20-00-00
DEPOSIT_BANK_IBAN=GB29 BARC 2000 0012 3456 78
DEPOSIT_BANK_SWIFT=BARCGB22
DEPOSIT_USDT_TRC20=TYourTRC20WalletAddressHere
DEPOSIT_USDT_ERC20=0xYourERC20WalletAddressHere
DEPOSIT_BTC_ADDRESS=bc1YourBitcoinAddressHere
DEPOSIT_ETH_ADDRESS=0xYourEthereumAddressHere
# CARD_PAYMENT_URL=https://checkout.stripe.com/your-link

# ── Security ─────────────────────────────────────────────────
# If not set, a random secret is generated and persisted in the database.
# For multi-instance deployments, set a fixed secret to share sessions.
# JWT_SECRET=your-very-long-random-secret-here

# ── Railway Specific (auto-set by Railway) ───────────────────
# RAILWAY_PUBLIC_DOMAIN=  (set automatically)
# RAILWAY_VOLUME_MOUNT_PATH=/data  (set automatically if volume is attached)
# DATABASE_URL=  (set if using Railway Postgres)
